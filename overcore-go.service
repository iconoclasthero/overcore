[Unit]
Description=overcore: sustained per-core CPU / temperature monitor
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/overcore -threshold 95 -core-threshold 95 -duration 10m -interval 10s -renotify 6h
Restart=on-failure
RestartSec=5

# Reads /proc and /sys only; needs no privileges beyond writing to the FIFO.
# Set User=/Group= to whatever can write the discord FIFO if not root.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/discord

[Install]
WantedBy=multi-user.target
