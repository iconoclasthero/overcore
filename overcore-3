log(){
    [[ "$1" = -d ]] && { discord=1; shift; } || discord=0
    ts="$(date -Is)"
#    printf '[%(%F %T)T] %s\n' -1 "$*"
#    (( discord )) && printf '[%(%F %T)T] %s\n' -1 "$*" >>"$fifo" 2>/dev/null
    printf '[%s] %s\n' "$ts" "$*"
#    (( discord )) && printf '[%s] %s\n' "$ts" "$*" >> "$fifo" 2>/dev/null
}

getpids(){
  # pid pcpu cmd – filtered to over threshold
  ps -eo pid,pcpu,comm --sort=-pcpu --no-headers |
    awk -v th="$threshold_cpu" '$2>th {print $1,$2,$3}'
}

getcores(){
  declare -g mpstatarray
  # core usage%
  readarray -t mpstatarray < <(mpstat -P ALL 1 1)
  printf %s\\n "${mpstatarray[@]}" |
    awk '/^[0-9]/ && $3!="CPU" {print $3,100-$NF+0.5}'
  (( verbose )) && for i in {2..8}; do printf '[verbose] %s\n' "${mpstatarray[$i]}" >&2 ; done
}

