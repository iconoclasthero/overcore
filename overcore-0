# --- helper function for logging
log() {
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$ts] $*"
}

# --- per-process CPU usage with logging
while read -r pid pcpu cmd; do
    pcpu=${pcpu%.*}
    if (( pcpu > threshold_cpu )); then
        [[ -z ${overcpu[$pid]} ]] && {
            overcpu[$pid]=$now
            log "⚠️ $cmd (pid $pid) exceeded CPU threshold ${threshold_cpu}% (current ${pcpu}%)"
        }

        if (( now - overcpu[$pid] >= duration_cpu )); then
            core=$(ps -p "$pid" -o psr= | tr -d ' ')
            log "📣 Sending alert: $cmd (pid $pid) on core $core >${threshold_cpu}% CPU for ${duration_cpu}s"
#            curl -s -H 'Content-Type: application/json' \
#                 -d "{\"content\":\"⚠️ $cmd (pid $pid) on core $core >${threshold_cpu}% CPU for ${duration_cpu}s\"}" \
#                 "$webhook"
                 discorddm "⚠️ $cmd (pid $pid) on core $core >${threshold_cpu}% CPU for ${duration_cpu}s"
            unset overcpu[$pid]
        fi
    else
        [[ -n ${overcpu[$pid]} ]] && log "$cmd (pid $pid) back under CPU threshold (${pcpu}%)"
        unset overcpu[$pid]
    fi
done < <(ps -eo pid,pcpu,comm --no-headers)


