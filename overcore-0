# --- per-core temperature (Intel/AMD)
core_index=0
for tempfile in /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp*_input; do
    temp=$(( $(<"$tempfile") / 1000 ))  # convert millidegree to °C
    key="core$core_index"

    if (( temp > threshold_temp )); then
        [[ -z ${overtemp[$key]} ]] && overtemp[$key]=$now
        if (( now - overtemp[$key] >= duration_temp )); then
#            curl -s -H 'Content-Type: application/json' \
#                 -d "{\"content\":\"🔥 $key temp ${temp}°C for ${duration_temp}s\"}" \
#                 "$webhook"
                     discorddm "🔥 $key temp ${temp}°C for ${duration_temp}s"
            unset overtemp[$key]
        fi
    else
        unset overtemp[$key]
    fi

    ((core_index++))
done


    sleep $checkint
done
