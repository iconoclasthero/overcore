  # --- per-core CPU (fixed: compare usage to threshold & prune)
  declare -A seencore=()
  while read -r core usage; do
    \sleep 1s

    usage=${usage%.*}
    (( verbose )) && printf '[verbose] $core: %s\n[verbose] $usage: %s\n' "$core" "$usage"

    if (( usage > threshold_cpu )); then
      seencore[$core]=1
      (( verbose )) && printf '[verbose] $core@$usage: %s@%s\n' "$core" "$usage"
      (( verbose == 1 )) && printf '[verbose] ${seencore[%s]}=%s\n\n' "$core" "${seencore[$core]}"

      # first time over threshold: start timer and skip duration test
      if [[ -z ${overcore[$core]} ]]; then
        overcore[$core]=$now
        (( verbose == 1 )) && printf '[verbose] continue\n'
        continue
      fi

      # subsequent iterations: check elapsed time
      if (( now - overcore[$core] >= duration_cpu )); then
        log -d "⚠️  core $core sustained >${threshold_cpu}% for ${duration_cpu}s (now ${usage}%)"
        unset overcore[$core]
      fi
    else
      # core currently under threshold: clear any existing timer
      [[ -n ${overcore[$core]} ]] && { log "core $core back under threshold (${usage}%)"; unset overcore[$core]; }
    fi
  done < <(getcores)

  # prune any overcore entries for cores getcores didn't report this iteration
  for c in "${!overcore[@]}"; do
    (( verbose == 1 )) && printf '[verbose] Begin prune step: ${seencore[%s]}=%s\n' "$c" "${seencore[$c]}"
    [[ -z ${seencore[$c]} ]] && unset overcore[$c]
    (( verbose == 1 )) && printf '[verbose] End prune step: ${seencore[%s]}=%s\n' "$c" "${seencore[$c]}"
  done


    ### --- per-core temperature
    core_index=0
    for tempfile in /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp*_input; do
        [[ ! -r "$tempfile" ]] && continue
        temp=$(( $(<"$tempfile") / 1000 ))
        key="core$core_index"

        if (( temp > threshold_temp )); then
            [[ -z ${overtemp[$key]} ]] && { overtemp[$key]=$now; continue; }
            if (( now - overtemp[$key] >= duration_temp )); then
                log -d "🔥 $key sustained ${temp}°C for ${duration_temp}s"
                unset overtemp[$key]
            fi
        else
            [[ -n ${overtemp[$key]} ]] && unset overtemp[$key]
        fi
        ((core_index++))
    done

    (( verbose == 1 )) && {
        echo "[verbose] $(date -Is) overpid=${!overpid[@]} overcore=${!overcore[@]} overtemp=${!overtemp[@]}"
    }

    sleep "$checkint"
done
